{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "types": ["node"],
        "rootDir": "src",
        "outDir": "dist",
        "noEmitOnError": true,
        "verbatimModuleSyntax": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "sourceMap": true
    },
    "include": ["src"]
}
